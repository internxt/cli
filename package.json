{
  "author": "Internxt <hello@internxt.com>",
  "version": "1.6.8",
  "description": "Internxt CLI to manage your encrypted storage",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo oclif.manifest.json",
    "lint": "eslint .",
    "format": "prettier --write **/*.{js,jsx,tsx,ts}",
    "postpack": "rimraf oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "prepare": "husky || true",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest watch",
    "dev:webdav": "nodemon -e ts --exec ts-node src/webdav/index.ts",
    "pack:win": "oclif pack win",
    "publish:npm": "npm run build && npm publish --scope=@internxt --registry=https://registry.npmjs.org/ --access public",
    "publish:github": "npm run build && npm publish --scope=@internxt --registry=https://npm.pkg.github.com --tag latest",
    "postinstall": "node ./scripts/restart-webdav.js"
  },
  "homepage": "https://github.com/internxt/cli",
  "license": "MIT",
  "main": "",
  "name": "@internxt/cli",
  "clientName": "internxt-cli",
  "repository": "https://github.com/internxt/cli",
  "bugs": "https://github.com/internxt/cli",
  "types": "dist/index.d.ts",
  "files": [
    ".env",
    "/bin",
    "/dist",
    "/scripts",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@dashlane/pqc-kem-kyber512-node": "1.0.0",
    "@inquirer/prompts": "8.5.2",
    "@internxt/inxt-js": "3.3.5",
    "@internxt/lib": "1.5.2",
    "@internxt/sdk": "1.20.2",
    "@oclif/core": "4.14.0",
    "@oclif/plugin-autocomplete": "3.3.0",
    "axios": "1.20.0",
    "better-sqlite3": "12.11.1",
    "bip39": "3.1.0",
    "body-parser": "2.3.0",
    "cli-progress": "3.12.0",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-async-handler": "1.2.0",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.11.0",
    "hash-wasm": "4.12.0",
    "mime-types": "3.0.2",
    "open": "11.0.1",
    "openpgp": "6.3.1",
    "otpauth": "9.5.1",
    "pm2": "7.0.4",
    "range-parser": "1.3.0",
    "selfsigned": "5.5.0",
    "tty-table": "5.0.0",
    "typeorm": "1.1.0",
    "uuid": "14.0.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@internxt/eslint-config-internxt": "^2.1.0",
    "@internxt/prettier-config": "^2.0.1",
    "@openpgp/web-stream-tools": "^0.3.1",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/range-parser": "^1.2.7",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/spy": "^4.1.10",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "oclif": "^4.23.30",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sql.js": "^1.14.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-mock-express": "^2.2.0"
  },
  "optionalDependencies": {
    "sharp": "0.35.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "bin": {
    "internxt": "./bin/run.js"
  },
  "oclif": {
    "bin": "internxt",
    "dirname": "internxt-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": " ",
    "topics": {},
    "hooks": {
      "prerun": "./dist/hooks/prerun/auth_check"
    },
    "macos": {
      "identifier": "com.internxt.cli"
    }
  },
  "lint-staged": {
    "*.{js,jsx,tsx,ts,cjs,mjs}": [
      "prettier --write"
    ]
  }
}
